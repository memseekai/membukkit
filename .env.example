# Copy to .env and fill in what you use. Only OPENAI_API_KEY is needed for the
# default quickstart; everything else is optional.

# --- Default provider (readers, distillation, remote embeddings) ---
OPENAI_API_KEY=sk-...

# --- Alternative LLM providers (optional) ---
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# Any OpenAI-compatible host (Together, Fireworks, DeepInfra, OpenRouter, Groq...);
# required by the gemma repro recipes (`membukkit bench --repro longmemeval-gemma` / beam-*):
# COMPAT_BASE_URL=https://api.together.xyz/v1
# COMPAT_API_KEY=

# --- Benchmark tuning (optional) ---
# Per-turn transcript cap for fact distillation; BEAM runs need 4000 (the
# repro recipes set this automatically when unset). Default: 600.
# MEMBUKKIT_DISTILL_MAX_TURN_CHARS=4000

# --- Zero-cost local models via Ollama (optional) ---
# OLLAMA_HOST=http://localhost:11434
# then use e.g. --llm ollama:llama3.1

# --- Persistent cloud vector storage (optional; default store is local) ---
# TURBOPUFFER_API_KEY=
# TURBOPUFFER_REGION=gcp-us-central1

# --- Model weights (optional override; default auto-downloads from HF Hub) ---
# MEMBUKKIT_MODEL_DIR=./models

# --- Local paths (optional) ---
# Root for stores, model cache, and saved keys. Default: ~/.membukkit
# (the Docker image sets this to /data so one volume holds everything).
# MEMBUKKIT_HOME=~/.membukkit
# Default store name for the CLI and the MCP server. Default: default
# MEMBUKKIT_STORE=notes
